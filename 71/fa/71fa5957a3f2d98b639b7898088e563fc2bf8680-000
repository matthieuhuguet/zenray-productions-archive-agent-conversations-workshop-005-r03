ject} t={t} paths={paths} NodeThumb={NodeThumb} onBack={() => setOpenId(null)} />\n        )\n      ) : <>\n          {categories.length > 2 && (\n            <nav style={{ display: 'flex', flexWrap: 'wrap', gap: 18, padding: '4px 0 26px', borderBottom: `1px solid ${t.border}` }}>\n              {categories.map((c) => {\n                const on = c === category\n                const n = c === 'Tout' ? projects.length : projects.filter((p) => p.category === c).length\n                return (\n                  <button key={c} type=\"button\" onClick={() => setCategory(c)}\n                    style={{ border: 0, background: 'transparent', cursor: 'pointer', padding: '2px 0', fontFamily: P.sans,\n                      fontSize: 13.5, color: on ? P.accent : t.textSecondary, boxShadow: on ? `inset 0 -1px 0 0 ${P.accent}` : undefined }}>\n                    {c}<span style={{ fontFamily: P.serif, fontWeight: P.numberWeight, fontSize: 11.5, opacity: 0.6, marginLeft: 6 }}>{n}</span>\n                  </button>\n                )\n              })}\n            </nav>\n          )}\n          {visible.length === 0 && (\n            <p style={{ maxWidth: '54ch', fontSize: 15, lineHeight: 1.66, color: t.textSecondary, margin: '30px 0 0' }}>\n              {projects.length === 0 ? 'Rien n’a encore été déposé.' : 'Aucun projet ne correspond.'}\n            </p>\n          )}\n          <div style={{ display: 'grid', gridTemplateColumns: P.projectGrid, gap: '34px 26px', paddingTop: 30 }}>\n            {visible.map((p, i) => (\n              <ProjectCard key={p.id} project={p} index={i} t={t} paths={paths} NodeThumb={NodeThumb} onOpen={() => setOpenId(p.id)} />\n            ))}\n          </div>\n        </>}\n    </div>\n  )\n}\n\n// A speaking thumbnail for an archived text file (md, html, css, js, json…): its title and first\n// lines, read once when the tile becomes visible, cached for the session. Files above TEXT_THUMB_MAX\n// keep their extension card: a thumbnail never downloads a heavy file.\n/* ════════════════════════════════════════════\n   THEME CONFIGURATION\n   Apple Human Interface Guidelines Inspired\n   ════════════════════════════════════════════ */\n\nexport const PALETTE = {\n  // Primary Action Color — Apple system blue (macOS Tahoe). Fini l'orange.\n  primary: \"#0A84FF\", // System Blue\n  primaryLight: \"#409CFF\",\n  primaryDark: \"#0060DF\",\n  primarySoft: \"rgba(10, 132, 255, 0.12)\", // teinte sélection macOS\n\n  // Gradient endpoints (bleu système discret)\n  gradientFrom: \"#0A84FF\",\n  gradientTo: \"#0060DF\",\n  gradient: \"linear-gradient(135deg, #0A84FF, #0060DF)\",\n\n  // Secondary / Accent Colors\n  blue: \"#007AFF\", // System Blue\n  green: \"#34C759\", // System Green\n  red: \"#FF3B30\",   // System Red — réservé au critique uniquement\n  orange: \"#d97757\", // Orange terracotta ZenRay — orange de design par défaut (jamais de rouge agressif sauf critique)\n  \n  // Grays / Neutrals\n  gray100: \"#F2F2F7\", // System Gray 6 (Light)\n  gray200: \"#E5E5EA\", // System Gray 5\n  gray300: \"#D1D1D6\", // System Gray 4\n  gray400: \"#C7C7CC\", // System Gray 3\n  gray500: \"#AEAEB2\", // System Gray 2\n  gray600: \"#8E8E93\", // System Gray\n  \n  // Text Colors (off-black / off-white, jamais purs)\n  textPrimaryLight: \"#1F1F1E\", // off-black\n  textSecondaryLight: \"#3C3C4399\", // Label Color (Secondary)\n  textPrimaryDark: \"#ECECEA\", // off-white clair\n  textSecondaryDark: \"rgba(236, 236, 234, 0.66)\", // Label Color (Secondary)\n\n  // Backgrounds (off-white / off-black de base)\n  bgLight: \"#FDFDFC\", // off-white de base\n  surfaceLight: \"#FDFDFC\",\n  bgDark: \"#1F1F1E\", // off-black de base\n  surfaceDark: \"#2A2A29\", // un cran plus clair pour cartes/surfaces\n};\n\nexport const THEMES = {\n  light: {\n    bg: \"#FDFDFC\",\n    surface: PALETTE.surfaceLight,\n    textPrimary: PALETTE.textPrimaryLight,\n    textSecondary: PALETTE.textSecondaryLight,\n    border: \"#e6e6e2\",\n    accent: PALETTE.primary, // Orange as primary accent\n    accentSoft: PALETTE.primarySoft,\n    accent2: PALETTE.primary, // Alias for accent\n    navBg: \"rgba(253, 253, 252, 0.97)\",\n    cardBg: PALETTE.surfaceLight,\n    \n    // Button Specifics\n    btnPrimaryBg: PALETTE.primary,\n    btnPrimaryText: \"#FFFFFF\",\n    btnSecondaryBg: PALETTE.gray200,\n    btnSecondaryText: PALETTE.textPrimaryLight,\n\n    // Liquid Glass / Finder white (Phase 0 OS)\n    windowBg: \"#EDEDEB\",\n    selection: \"rgba(0,122,255,0.16)\",\n    hairline: \"0.5px solid rgba(0,0,0,0.10)\",\n    glass: {\n      // dérivé de #FDFDFC, transparence conservée pour laisser passer le wallpaper\n      bg: \"rgba(253,253,252,0.70)\",\n      bgStrong: \"rgba(253,253,252,0.84)\",\n      filter: \"blur(28px) saturate(200%)\",\n      filterThick: \"blur(44px) saturate(210%)\",\n      edge: \"inset 0 1px 0 rgba(255,255,255,0.85), inset 0 0 0 0.5px rgba(255,255,255,0.45)\",\n    },\n  },\n  dark: {\n    bg: PALETTE.bgDark,\n    surface: PALETTE.surfaceDark,\n    textPrimary: PALETTE.textPrimaryDark,\n    textSecondary: PALETTE.textSecondaryDark,\n    border: \"#3A3A38\", // bordure douce sur fond off-black\n    accent: PALETTE.primary,\n    accentSoft: \"rgba(10, 132, 255, 0.25)\",\n    accent2: \"#ECECEA\", // off-white accent for outlines in dark mode\n    navBg: \"rgba(31, 31, 30, 0.97)\",\n    cardBg: PALETTE.surfaceDark,\n\n    // Button Specifics\n    btnPrimaryBg: PALETTE.primary,\n    btnPrimaryText: \"#FFFFFF\",\n    btnSecondaryBg: \"#33322F\", // surface un cran plus claire pour boutons\n    btnSecondaryText: PALETTE.textPrimaryDark,\n\n    windowBg: \"#262624\",\n    selection: \"rgba(10,132,255,0.28)\",\n    hairline: \"0.5px solid rgba(255,255,255,0.10)\",\n    glass: {\n      // dérivé de #1F1F1E, transparence conservée pour laisser passer le wallpaper\n      bg: \"rgba(31,31,30,0.66)\",\n      bgStrong: \"rgba(31,31,30,0.84)\",\n      filter: \"blur(20px) saturate(160%)\",\n      filterThick: \"blur(40px) saturate(180%)\",\n      edge: \"inset 0 1px 0 rgba(255,255,255,0.10), inset 0 0 0 0.5px rgba(255,255,255,0.08)\",\n    },\n  }\n};\n\n/* ════════════════════════════════════════════\n   COMMON STYLES (Mixins)\n   ════════════════════════════════════════════ */\n\nexport const SHADOWS = {\n  sm: \"0 1px 2px rgba(0,0,0,0.05)\",\n  md: \"0 4px 6px -1px rgba(0,0,0,0.1), 0 2px 4px -1px rgba(0,0,0,0.06)\",\n  lg: \"0 10px 15px -3px rgba(0,0,0,0.1), 0 4px 6px -2px rgba(0,0,0,0.05)\",\n  apple: \"0 8px 30px rgba(0,0,0,0.12)\", // Soft diffuse shadow\n  glow: `0 0 20px ${PALETTE.primarySoft}`,\n};\n\n// Quick Look open (grow) and close (shrink) duration, set by Matthieu on 2 October 2026 (0.2 s both ways).\nexport const QUICKLOOK_ANIM_MS = 200\n\nexport const TRANSITIONS = {\n  // EaseOutExpo — décélération premium commune aux interactions ZenRay.\n  micro: \"all 0.15s cubic-bezier(0.16, 1, 0.3, 1)\",\n  base: \"all 0.225s cubic-bezier(0.16, 1, 0.3, 1)\",\n  smooth: \"all 0.325s cubic-bezier(0.16, 1, 0.3, 1)\",\n  bounce: \"all 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275)\", // Springy\n};\n\nexport const RADII = {\n  sm: \"8px\",\n  md: \"12px\", // Modern Apple Rounded Square\n  lg: \"16px\",\n  xl: \"20px\",\n};\n\n// Pile de polices Anthropic (Sans/Serif/Mono) — déplacé depuis App.jsx (batch refactor structurel\n// 2026-07-16) pour être importable depuis les composants extraits sans dépendre de App.jsx.\nexport const FONTS = {\n  display: \"'GT Super Display', var(--zr-police-serif)\",\n  serif: \"var(--zr-police-serif)\",\n  sans: \"var(--zr-police-sans)\",\n  mono: \"var(--zr-police-mono)\",\n};\n\n// Chrome en verre (sidebar, toolbar, panneaux). Le CONTENU reste opaque (card()).\nexport const glassPanel = (t) => {\n  const g = (t && t.glass) || THEMES.light.glass;\n  return {\n    background: g.bg,\n    backdropFilter: g.filter,\n    WebkitBackdropFilter: g.filter,\n    boxShadow: `${g.edge}, ${SHADOWS.apple}`,\n  };\n};\n\n// Apple Liquid Glass — preset NORMAL, migré le 2026-07-19 vers la recette V9 unique du reste du site\n// (fonts.css :root/.zr-dark, `--g9-*`, ratio de liseré 0.20) : clic droit, fil d'ariane, menu \"...\", menu\n// \"New\" utilisaient encore l'ANCIEN verre (rgba fixes, jamais mis à jour depuis la V9 -- retour Matthieu\n// 2026-07-19, captures des 4 menus). Valeurs recopiées ICI en dur plutôt que lues via var(--g9-*) : ce\n// composant se porte dans document.body (ColumnMenuShell -> createPortal), HORS de la div .zr-dark posée\n// sur la racine de l'app (App.jsx) -- des var(--g9-*) y résoudraient TOUJOURS les valeurs :root (clair),\n// jamais .zr-dark, quel que soit le thème réellement actif. `t` (déjà passé par tous les appelants) reste\n// donc la seule source fiable de dark/light ici. Chiffres = exactement ceux de fonts.css à ratio 0.20 (le\n// défaut actuel de --g9-rim-ratio) : une divergence du curseur global n'est PAS suivie par ce menu (portail\n// hors arbre), mais les DEUX presets restent synchronisés avec la valeur de référence du jour.\nexport const liquidGlassNormal = (t) => {\n  const dark = t && t.textPrimary === PALETTE.textPrimaryDark;\n{\n  \"name\": \"zenray-progress\",\n  \"private\": true,\n  \"version\": \"0.1.0\",\n  \"type\": \"module\",\n  \"description\": \"ZenRayProgress — LifeOS de Matthieu Huguet : tableau de bord d'objectifs + agenda hebdomadaire, persistant.\",\n  \"scripts\": {\n    \"dev\": \"vite\",\n    \"build\": \"vite build\",\n    \"preview\": \"vite preview\",\n    \"test\": \"vitest run\",\n    \"test:watch\": \"vitest\",\n    \"test:music\": \"vitest run src/audio src/create --passWithNoTests\",\n    \"test:e2e\": \"playwright test\"\n  },\n  \"dependencies\": {\n    \"@blocknote/core\": \"^0.51.3\",\n    \"@blocknote/mantine\": \"^0.51.3\",\n    \"@blocknote/react\": \"^0.51.3\",\n    \"@ffmpeg/core\": \"^0.12.10\",\n    \"@ffmpeg/ffmpeg\": \"^0.12.15\",\n    \"@ffmpeg/util\": \"^0.12.2\",\n    \"@jsquash/jpeg\": \"^1.6.0\",\n    \"@jsquash/webp\": \"^1.5.0\",\n    \"@upstash/redis\": \"^1.34.3\",\n    \"@vercel/analytics\": \"^1.3.1\",\n    \"dashjs\": \"^4.7.4\",\n    \"epubjs\": \"^0.3.93\",\n    \"fflate\": \"^0.8.3\",\n    \"heic2any\": \"^0.0.4\",\n    \"hls.js\": \"^1.6.16\",\n    \"jassub\": \"^1.8.8\",\n    \"mammoth\": \"^1.12.0\",\n    \"marked\": \"^14.1.3\",\n    \"masonic\": \"^4.1.0\",\n    \"react\": \"^19.2.0\",\n    \"react-dom\": \"^19.2.0\",\n    \"three\": \"^0.185.0\",\n    \"tldraw\": \"^5.0.1\",\n    \"utif\": \"^3.1.0\",\n    \"xlsx\": \"^0.18.5\"\n  },\n  \"devDependencies\": {\n    \"@playwright/test\": \"^1.61.1\",\n    \"@testing-library/jest-dom\": \"^6.9.1\",\n    \"@testing-library/react\": \"^16.3.2\",\n    \"@vitejs/plugin-react\": \"^4.3.4\",\n    \"jsdom\": \"^24.1.3\",\n    \"vite\": \"^5.4.11\",\n    \"vitest\": \"^3.2.6\"\n  }\n}\n","exit_code":0,"duration":{"secs":0,"nanos":11792},"formatted_output":"     555 CLAUDE.md\n     158 /Users/zenray/.claude/rules/Typography1.md\n     396 /Users/zenray/.claude/rules/ParametricHda1.md\n     150 /Users/zenray/.claude/rules/ZenRayProjects1.md\n    1259 total\n// ZenRay Assets v2, pure logic (2026-09-11): the project schema reader, the folder listing, the\n// sections and the storage state. No React, no network: tested in assetsProjects.test.js.\n// FR : logique pure de ZenRay Assets, sans interface ni réseau, testée à part.\nimport { entriesOf } from '../create/buildNodes.js'\nimport { stripLeafExt } from '../create/node.js'\nimport { UI } from '../config/colors.js'\n\nexport const readableSize = (b) => (!Number.isFinite(b) || b <= 0) ? '' : b < 1e6 ? `${Math.max(1, Math.round(b / 1e3))} Ko` : b < 1e9 ? `${(b / 1e6).toFixed(1).replace('.', ',')} Mo` : `${(b / 1e9).toFixed(2).replace('.', ',')} Go`\n\nexport const DEFAULT_ASSETS_PROJECTS = [\n  {\n    id: 'zenray-assets-materials',\n    name: 'ZenRay Assets Materials',\n    category: 'Materials',\n    summary: 'Collection et sauvegarde de matériaux PBR procéduraux issus de Substance 3D Designer et Houdini Copernicus, avec visualiseur WebGL temps réel et isolation des calques (Albedo, Normal, Roughness, Metallic, Height, AO).',\n    date: '2026-09-19',\n    folder: 'pages/ZenRayAssets/tmp-zenray-assets-materials',\n    cover: null,\n    sources: [\n      { localPath: '/Users/zenray/Create/Build/Productions/ZenRayShards', target: 'materials', keep: true, present: true }\n    ],\n    showcase: [],\n    components: [],\n  },\n  {\n    id: 'zenray-assets-meshes',\n    name: 'ZenRay Assets Meshes',\n    category: '3D',\n    summary: 'Bibliothèque et sauvegarde de meshes 3D (Static Meshes et Skeletal Meshes pour Unreal Engine et Houdini), avec inspecteur WebGL temps réel (Shaded, Wireframe, Normales, MatCap Clay, polycount et dimensions).',\n    date: '2026-09-19',\n    folder: 'pages/ZenRayAssets/tmp-zenray-assets-meshes',\n    cover: null,\n    sources: [\n      { localPath: '/Users/zenray/Create/Build/Productions/ZenRayShards', target: 'meshes', keep: true, present: true }\n    ],\n    showcase: [],\n    components: [],\n  },\n]\n\nexport const compareProjectsByDateDesc = (a, b) => {\n  const da = a?.date || ''\n  const db = b?.date || ''\n  if (da && db && da !== db) return db.localeCompare(da)\n  if (db && !da) return 1\n  if (da && !db) return -1\n  return 0\n}\n\n// Fusionne les projets du registre drive avec les projets par defaut indispensables,\n// et trie de maniere strictement decroissante (les plus recents en premier comme une boite mail).\nexport function mergeAssetsProjects(driveProjects) {\n  const list = Array.isArray(driveProjects) ? driveProjects.map(normalizeProject).filter(Boolean) : []\n  const knownIds = new Set(list.map((p) => p.id))\n  const missing = DEFAULT_ASSETS_PROJECTS.filter((p) => !knownIds.has(p.id))\n  const merged = [...list, ...missing]\n  return merged.sort(compareProjectsByDateDesc)\n}\n\n// Schema v2 is English. Projects written before 2026-09-11 used French keys; this single reader\n// accepts both, so no project already on the drive is lost. Writers only produce the English keys.\n// FR : le schéma v2 est en anglais ; ce lecteur unique accepte encore les anciennes clés françaises.\nexport function normalizeProject(p) {\n  if (!p || typeof p !== 'object') return null\n  return {\n    id: p.id || p.nom || p.name,\n    name: p.name ?? p.nom ?? '',\n    category: p.category ?? p.categorie ?? '',\n    summary: p.summary ?? p.resume ?? '',\n    date: p.date ?? p.depose ?? '',\n    demo: !!p.demo,\n    folder: p.folder || null,\n    cover: p.cover || null,\n    sources: Array.isArray(p.sources) ? p.sources : [],\n    showcase: (p.showcase ?? p.vitrine ?? []).map((v) => ({ image: v.image, title: v.title ?? v.titre, note: v.note })),\n    components: (p.components ?? p.composants ?? []).map((c) => ({\n      name: c.name ?? c.nom, group: c.group ?? c.groupe, short: c.short ?? c.court, engine: c.engine ?? c.moteur,\n      size: c.size ?? c.poids, date: c.date, link: c.link ?? c.lien,\n    })),\n  }\n}\n\n\n// Every leaf path under a project folder. `.DS_Store` never counts as an asset.\n// FR : tous les chemins feuilles sous le dossier d'un projet.\nexport function projectPaths(folder, paths) {\n  if (!folder) return []\n  const prefix = folder.endsWith('/') ? folder : `${folder}/`\n  return paths.filter((p) => p.startsWith(prefix) && !/(^|\\/)\\.DS_Store/.test(p))\n}\n\n// The cover of a project, always a real image MANIFEST. A plan may name the source file\n// (`carnet/IMG_7160.jpeg`) or its manifest; both resolve, and without either the first image wins.\n// FR : la couverture est toujours un manifeste d'image réel, qu'on la nomme par le fichier ou le manifeste.\nexport function coverPath(project, own) {\n  const c = project.cover\n  if (c) {\n    if (own.includes(c)) return c\n    const hit = own.find((p) => p.endsWith('.img.json') && stripLeafExt(p) === c)\n    if (hit) return hit\n  }\n  return own.find((p) => p.endsWith('.img.json')) || null\n}\n\n// 2026-09-23 : up to `max` images for a card mosaic, the chosen cover first.\n// FR : jusqu'a `max` images pour la mosaique d'une carte, la couverture en premier.\nexport function coverPaths(project, own, max = 4) {\n  const first = coverPath(project, own)\n  const rest = own.filter((p) => p.endsWith('.img.json') && p !== first)\n  return (first ? [first, ...rest] : rest).slice(0, max)\n}\n\nconst isFile = (e) => !!e.contentPath && !e.hasKids\nconst under = (own, dir) => own.filter((p) => p.startsWith(`${dir}/`))\n\n// What one folder of a project shows, INSIDE ZenRay Assets: its own files, then one group per\n// sub-folder with that sub-folder's files, and deeper folders as cards that open in place.\n// FR : ce qu'un dossier montre dans ZenRay Assets, ses fichiers, puis un groupe par sous-dossier,\n// et les dossiers plus profonds en cartes qui s'ouvrent sur place, sans basculer dans Create.\nexport function folderView(dir, own) {\n  const kids = entriesOf(own, dir)\n  // 2026-09-11 A folder card shows the folder icon, never the first image inside: that image is often\n  // unrelated (the app wallpaper in an HDA history snapshot) and makes a folder look like a file.\n  // FR : une carte de dossier montre l'icône dossier, jamais la première image trouvée dedans.\n  const card = (f) => ({ dir: f.dir, name: f.name, count: under(own, f.dir).length })\n  return {\n    files: kids.filter(isFile),\n    groups: kids.filter((e) => e.hasKids).map((sub) => {\n      const k = entriesOf(own, sub.dir)\n      return { dir: sub.dir, title: sub.name, count: under(own, sub.dir).length, files: k.filter(isFile), folders: k.filter((e) => e.hasKids).map(card) }\n    }),\n  }\n}\n\n// The breadcrumb from the project folder down to the open folder. FR : le fil d'Ariane du projet.\nexport function crumbs(root, dir) {\n  if (!dir || dir === root || !dir.startsWith(`${root}/`)) return []\n  const parts = dir.slice(root.length + 1).split('/')\n  return parts.map((name, i) => ({ name, dir: `${root}/${parts.slice(0, i + 1).join('/')}` }))\n}\n\n// Project-level storage state: orange as soon as one source still sits on the Mac.\n// FR : état du projet, orange dès qu'une source est encore sur le Mac.\nexport function storageState(project) {\n  const sources = project.sources || []\n  if (!sources.length) return null\n  // A `keep` source is versioned elsewhere (Git): it stays on the Mac by design and never counts as\n  // space to free. FR : une source `keep` est versionnée ailleurs, elle reste sur le Mac et ne compte pas.\n  const local = sources.filter((s) => s.present && !s.keep)\n  const bytes = local.reduce((n, s) => n + (Number(s.bytes) || 0), 0)\n  return local.length\n    ? { color: UI.orange, label: `Aussi sur ce Mac${bytes ? ` · ${readableSize(bytes)}` : ''}` }\n    : { color: UI.green, label: 'Uniquement sur le cloud' }\n}\n\n// The colour and label of ONE source line. FR : couleur et libellé d'une ligne de source.\nexport function sourceState(s) {\n  if (s.keep) return { color: UI.blue, label: 'versionné, reste sur le Mac' }\n  return s.present ? { color: UI.orange, label: readableSize(s.bytes) || 'sur le Mac' } : { color: UI.green, label: 'supprimé du Mac' }\n}\n\n// A speaking thumbnail for a text file: its title and first lines, read from the file itself.\n// Markdown keeps its words without the syntax, HTML its <title> and visible text, code its first lines.\n// FR : la vignette parlante d'un fichier texte, son titre et ses premières lignes, lus dans le fichier.\nexport function excerptOf(name, text, maxLines = 9) {\n  const ext = (/\\.([a-z0-9]+)$/i.exec(name || '') || [])[1]?.toLowerCase() || ''\n  const src = String(text || '')\n  if (ext === 'md' || ext === 'markdown') {\n    const lines = src.split('\\n').map((l) => l.trim()).filter((l) => l && !/^(-{3,}|```|\\|?[-:| ]+\\|?)$/.test(l))\n    const heading = lines.find((l) => /^#{1,6}\\s/.test(l))\n    const clean = (l) => l.replace(/^#{1,6}\\s+|^>\\s?|^[-*+]\\s+|^\\d+\\.\\s+/, '').replace(/[*_`]/g, '').replace(/\\[([^\\]]*)\\]\\([^)]*\\)/g, '$1').replace(/\\|/g, ' ').trim()\n    const body = lines.filter((l) => l !== heading).map(clean).filter(Boolean)\n    return { title: heading ? clean(heading) : '', lines: body.slice(0, maxLines), mono: false }\n  }\n  if (ext === 'html' || ext === 'htm') {\n    const title = (/<title[^>]*>([\\s\\S]*?)<\\/title>/i.exec(src) || [])[1]?.trim() || ''\n    const body = src.replace(/<(script|style|head)[\\s\\S]*?<\\/\\1>/gi, ' ')\n      .replace(/<\\/(p|div|h[1-6]|li|section|article|header|footer|tr)>|<br\\s*\\/?>/gi, '\\n')\n      .replace(/<[^>]+>/g, ' ').replace(/&nbsp;/g, ' ').replace(/&amp;/g, '&').replace(/&[a-z#0-9]+;/gi, ' ')\n    const lines = body.split('\\n').map((l) => l.replace(/\\s+/g, ' ').trim()).filter((l) => l.length > 1)\n    return { title, lines: lines.slice(0, maxLines), mono: false }\n  }\n  const lines = src.split('\\n').map((l) => l.replace(/\\t/g, '  ').replace(/\\s+$/, '')).filter((l) => l.trim())\n  return { title: '', lines: lines.slice(0, maxLines + 3), mono: true }\n}\n// ZENRAY ASSETS v2 (2026-09-11).\n//\n// A drive of LINKS, not a gallery of templates. A project is a Create folder\n// `pages/ZenRayAssets/tmp-<slug>/` where every file was uploaded (archive-folder.mjs, skill\n// zenray-assets). This view never stores a byte: it reads the project list from\n// `pages/.zr-assets.json`, lists each project folder from the search INDEX the app already loaded\n// (zero quota), draws each file with Create's own thumbnail (NodeThumb, passed by App) and opens it\n// in Create's Quick Look. Everything stays archived and downloadable in Create.\n//\n// FR : un drive de LIENS, pas une galerie de gabarits. Un projet est un dossier Create\n// `tmp-<slug>` ; cette vue ne stocke rien, elle liste le dossier depuis l'index (aucune requête de\n// quota), montre chaque fichier avec la vignette de Create et l'ouvre dans le Quick Look.\n//\n// The green / orange dot: the browser cannot see the Mac's disk, so the upload script records, per\n// source, whether the local copy still exists (`sources[].present`). Orange = still on the Mac, it\n// takes space; green = only in the cloud. The button copies the verified purge command, it never\n// deletes anything itself.\n// FR : pastille verte = uniquement sur le cloud, orange = encore sur le Mac ; le bouton copie la\n// commande de purge vérifiée, il ne supprime jamais rien lui-même.\nimport React, { useEffect, useMemo, useState } from 'react'\nimport { readJson } from '../lib/saveJson.js'\nimport { loadSearchIndex, getIndexPaths, getNodeSize } from '../search/searchIndexClient.js'\nimport { pgPretty } from '../lib/pgPretty.js'\nimport { DOT } from '../config/colors.js'\nimport { readableSize, normalizeProject, mergeAssetsProjects, compareProjectsByDateDesc, projectPaths, coverPath, coverPaths, folderView, crumbs, excerptOf, storageState, sourceState } from '../lib/assetsProjects.js'\nimport { kindForName } from '../lib/fileKinds.js'\nimport { urlLectureAffichage } from '../lib/urlLecture.js'\nimport { downloadUrls } from '../lib/archiveChunks.js'\nimport { assembleBlobUrl } from '../lib/fetchAsset.js'\nimport { useInView } from '../media/useImageThumb.js'\nimport { lazyRetry } from '../lib/lazyRetry.js'\nimport { notify } from './Notifications.jsx'\nimport QuickLookOverlay from './QuickLookOverlay.jsx'\n\nconst LazyMaterialStudio = lazyRetry(() => import('./assets/MaterialStudio.jsx'))\nconst LazyMeshStudio = lazyRetry(() => import('./assets/MeshStudio.jsx'))\n\nconst STORE_PATH = 'pages/.zr-assets.json'\nconst PURGE_COMMAND = 'node ~/.claude/skills/zenray-assets/scripts/zenray-assets-upload.mjs free'\n\n// The parameter interface of the page: every value judged by eye lives here and nowhere else.\n// FR : l'interface de paramètres de la page, toute valeur jugée à l'œil vit ici.\nconst P = {\n  serif: 'var(--zr-police-serif)',\n  sans: 'var(--zr-police-sans)',\n  mono: 'var(--zr-police-mono)',\n  serifWeight: 350,\n  numberWeight: 400,\n  accent: '#9A5B3C',\n  column: 1240,\n  projectGrid: 'repeat(auto-fill, minmax(min(100%, 300px), 1fr))',\n  fileGrid: 'repeat(auto-fill, minmax(min(100%, 176px), 1fr))',\n  coverRatio: '4 / 3',\n  fileRatio: '1 / 1',\n  coverThumb: 300,\n  fileThumb: 150,\n  radius: 8,\n  mosaicMax: 4,      // images shown on a project card (Matthieu, 2026-09-23)\n  mosaicGap: 2,\n}\n\nconst MONTHS = ['janvier', 'février', 'mars', 'avril', 'mai', 'juin', 'juillet', 'août', 'septembre', 'octobre', 'novembre', 'décembre']\nconst readableDate = (iso) => (!iso || iso.length < 10) ? (iso || '') : `${Number(iso.slice(8, 10))} ${MONTHS[Number(iso.slice(5, 7)) - 1]} ${iso.slice(0, 4)}`\nconst extensionOf = (e) => { const m = /\\.([a-z0-9]{1,6})$/i.exec(e.name || ''); return m ? m[1].toUpperCase() : '' }\n\n// The fallback plate, from mockup 02: a declared placeholder, never a fake render.\n// FR : la planche de repli, un emplacement déclaré, jamais une fausse capture.\nfunction softPlate(i = 0) {\n  const h = [42, 22, 336, 205, 138][i % 5]\n  const line = 'rgba(34,33,30,0.26)'\n  const pattern = `repeating-linear-gradient(${38 + (i % 3) * 17}deg, ${line} 0 .5px, transparent .5px 13px)`\n  return `${pattern}, linear-gradient(${146 + (i % 4) * 21}deg, hsl(${h} 16% 93%), hsl(${h} 16% 85%))`\n}\n\nfunction Dot({ color }) {\n  return <span aria-hidden=\"true\" style={{ width: DOT.size, height: DOT.size, borderRadius: 999, background: color, flex: '0 0 auto' }} />\n}\n\nfunction StatusPill({ color, children, t }) {\n  return (\n    <span style={{ display: 'inline-flex', alignItems: 'center', gap: DOT.gap, fontSize: 12.5, color: t.textSecondary, whiteSpace: 'nowrap' }}>\n      <Dot color={color} />{children}\n    </span>\n  )\n}\n\nfunction useIndexPaths() {\n  const [paths, setPaths] = useState(() => getIndexPaths())\n  useEffect(() => {\n    let alive = true\n    loadSearchIndex().then(() => { if (alive) setPaths(getIndexPaths()) }).catch(() => {})\n    return () => { alive = false }\n  }, [])\n  return paths\n}\n\nexport default function AssetsView({ t, NodeThumb }) {\n  const [projects, setProjects] = useState(null)\n  const [category, setCategory] = useState('Tout')\n  const [query, setQuery] = useState('')\n  const [openId, setOpenId] = useState(null)\n  const paths = useIndexPaths()\n\n  useEffect(() => {\n    let alive = true\n    readJson(STORE_PATH)\n      .then(({ data }) => {\n        if (!alive) return\n        const list = data && (data.projects || data.projets)\n        setProjects(mergeAssetsProjects(list))\n      })\n      .catch(() => { if (alive) setProjects(mergeAssetsProjects([])) })\n    return () => { alive = false }\n  }, [])\n\n  // Categories come from the projects themselves: a new category appears without touching this file.\n  // FR : les catégories viennent des projets eux-mêmes.\n  const categories = useMemo(() => {\n    if (!projects) return []\n    return ['Tout', ...[...new Set(projects.map((p) => p.category).filter(Boolean))].sort()]\n  }, [projects])\n\n  const visible = useMemo(() => {\n    if (!projects) return []\n    const q = query.trim().toLowerCase()\n    return projects\n      .filter((p) => (category === 'Tout' || p.category === category)\n        && (!q || `${p.name} ${p.summary} ${p.components.map((c) => `${c.name} ${c.short}`).join(' ')}`.toLowerCase().includes(q)))\n      .sort(compareProjectsByDateDesc)\n  }, [projects, category, query])\n\n  if (!projects) return <div style={{ color: t.textSecondary, padding: 24, fontFamily: P.sans }}>chargement…</div>\n\n  const openProject = openId ? projects.find((p) => p.id === openId) : null\n\n  return (\n    <div style={{ maxWidth: P.column, margin: '0 auto', padding: '22px 34px 96px', fontFamily: P.sans, color: t.textPrimary }}>\n      <header style={{ display: 'flex', alignItems: 'flex-end', gap: 24, flexWrap: 'wrap', paddingBottom: 18 }}>\n        <h1 onClick={() => setOpenId(null)} style={{ fontFamily: P.serif, fontWeight: P.serifWeight, fontSize: 27, letterSpacing: '-0.015em', margin: 0, lineHeight: 1.1, cursor: openProject ? 'pointer' : 'default' }}>\n          ZenRay <em style={{ fontStyle: 'italic', fontWeight: 300, color: t.textSecondary }}>Assets</em>\n        </h1>\n        {!openProject && (\n          <label style={{ marginLeft: 'auto', display: 'flex', alignItems: 'center', gap: 9, minWidth: 260, flex: '0 1 340px',\n            borderBottom: `1px solid ${t.border}`, padding: '5px 2px' }}>\n            <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke={t.textSecondary} strokeWidth=\"2\"\n              strokeLinecap=\"round\" aria-hidden=\"true\" style={{ flex: '0 0 14px' }}>\n              <circle cx=\"11\" cy=\"11\" r=\"7\" /><path d=\"M20 20l-3.6-3.6\" />\n            </svg>\n            <input value={query} onChange={(e) => setQuery(e.target.value)} placeholder=\"Rechercher dans la collection\"\n              style={{ flex: 1, minWidth: 0, border: 0, outline: 'none', background: 'transparent', color: t.textPrimary, fontFamily: P.sans, fontSize: 14 }} />\n          </label>\n        )}\n      </header>\n\n      {openProject ? (\n        openProject.id === 'zenray-assets-materials' || openProject.category === 'Materials' ? (\n          <React.Suspense fallback={<div style={{ color: t.textSecondary, padding: 24, fontFamily: P.sans }}>chargement du studio…</div>}>\n            <LazyMaterialStudio project={openProject} t={t} onBack={() => setOpenId(null)} />\n          </React.Suspense>\n        ) : openProject.id === 'zenray-assets-meshes' ? (\n          <React.Suspense fallback={<div style={{ color: t.textSecondary, padding: 24, fontFamily: P.sans }}>chargement du studio…</div>}>\n            <LazyMeshStudio project={openProject} t={t} onBack={() => setOpenId(null)} />\n          </React.Suspense>\n        ) : (\n          <ProjectDetail project={openProject} t={t} paths={paths} NodeThumb={NodeThumb} onBack={() => setOpenId(null)} />\n        )\n      ) : <>\n          {categories.length > 2 && (\n            <nav style={{ display: 'flex', flexWrap: 'wrap', gap: 18, padding: '4px 0 26px', borderBottom: `1px solid ${t.border}` }}>\n              {categories.map((c) => {\n                const on = c === category\n                const n = c === 'Tout' ? projects.length : projects.filter((p) => p.category === c).length\n                return (\n                  <button key={c} type=\"button\" onClick={() => setCategory(c)}\n                    style={{ border: 0, background: 'transparent', cursor: 'pointer', padding: '2px 0', fontFamily: P.sans,\n                      fontSize: 13.5, color: on ? P.accent : t.textSecondary, boxShadow: on ? `inset 0 -1px 0 0 ${P.accent}` : undefined }}>\n                    {c}<span style={{ fontFamily: P.serif, fontWeight: P.numberWeight, fontSize: 11.5, opacity: 0.6, marginLeft: 6 }}>{n}</span>\n                  </button>\n                )\n              })}\n            </nav>\n          )}\n          {visible.length === 0 && (\n            <p style={{ maxWidth: '54ch', fontSize: 15, lineHeight: 1.66, color: t.textSecondary, margin: '30px 0 0' }}>\n              {projects.length === 0 ? 'Rien n’a encore été déposé.' : 'Aucun projet ne correspond.'}\n            </p>\n          )}\n          <div style={{ display: 'grid', gridTemplateColumns: P.projectGrid, gap: '34px 26px', paddingTop: 30 }}>\n            {visible.map((p, i) => (\n              <ProjectCard key={p.id} project={p} index={i} t={t} paths={paths} NodeThumb={NodeThumb} onOpen={() => setOpenId(p.id)} />\n            ))}\n          </div>\n        </>}\n    </div>\n  )\n}\n\n// A speaking thumbnail for an archived text file (md, html, css, js, json…): its title and first\n// lines, read once when the tile becomes visible, cached for the session. Files above TEXT_THUMB_MAX\n// keep their extension card: a thumbnail never downloads a heavy file.\n/* ════════════════════════════════════════════\n   THEME CONFIGURATION\n   Apple Human Interface Guidelines Inspired\n   ════════════════════════════════════════════ */\n\nexport const PALETTE = {\n  // Primary Action Color — Apple system blue (macOS Tahoe). Fini l'orange.\n  primary: \"#0A84FF\", // System Blue\n  primaryLight: \"#409CFF\",\n  primaryDark: \"#0060DF\",\n  primarySoft: \"rgba(10, 132, 255, 0.12)\", // teinte sélection macOS\n\n  // Gradient endpoints (bleu système discret)\n  gradientFrom: \"#0A84FF\",\n  gradientTo: \"#0060DF\",\n  gradient: \"linear-gradient(135deg, #0A84FF, #0060DF)\",\n\n  // Secondary / Accent Colors\n  blue: \"#007AFF\", // System Blue\n  green: \"#34C759\", // System Green\n  red: \"#FF3B30\",   // System Red — réservé au critique uniquement\n  orange: \"#d97757\", // Orange terracotta ZenRay — orange de design par défaut (jamais de rouge agressif sauf critique)\n  \n  // Grays / Neutrals\n  gray100: \"#F2F2F7\", // System Gray 6 (Light)\n  gray200: \"#E5E5EA\", // System Gray 5\n  gray300: \"#D1D1D6\", // System Gray 4\n  gray400: \"#C7C7CC\", // System Gray 3\n  gray500: \"#AEAEB2\", // System Gray 2\n  gray600: \"#8E8E93\", // System Gray\n  \n  // Text Colors (off-black / off-white, jamais purs)\n  textPrimaryLight: \"#1F1F1E\", // off-black\n  textSecondaryLight: \"#3C3C4399\", // Label Color (Secondary)\n  textPrimaryDark: \"#ECECEA\", // off-white clair\n  textSecondaryDark: \"rgba(236, 236, 234, 0.66)\", // Label Color (Secondary)\n\n  // Backgrounds (off-white / off-black de base)\n  bgLight: \"#FDFDFC\", // off-white de base\n  surfaceLight: \"#FDFDFC\",\n  bgDark: \"#1F1F1E\", // off-black de base\n  surfaceDark: \"#2A2A29\", // un cran plus clair pour cartes/surfaces\n};\n\nexport const THEMES = {\n  light: {\n    bg: \"#FDFDFC\",\n    surface: PALETTE.surfaceLight,\n    textPrimary: PALETTE.textPrimaryLight,\n    textSecondary: PALETTE.textSecondaryLight,\n    border: \"#e6e6e2\",\n    accent: PALETTE.primary, // Orange as primary accent\n    accentSoft: PALETTE.primarySoft,\n    accent2: PALETTE.primary, // Alias for accent