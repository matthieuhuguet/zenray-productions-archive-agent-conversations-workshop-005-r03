: source.present || source.status === 'present' ? 'Sur ce Mac' : 'Absent du Mac' : 'État local à vérifier'}</Status>{Number.isFinite(source.bytes) && <span className=\"assets-number\">{readableSize(source.bytes) || '0 Ko'}</span>}</div>\n            <div className=\"assets-source-destination\"><Icon name=\"arrow.down.right\" size={13} /><code>{source.cloudPath || source.destination || source.target || `${project.folder || 'ZenRayAssets'}/${type.id}`}</code></div>\n          </div>) : <div className=\"assets-origin-unlinked\"><span>Aucun dossier relié</span>{onLinkProject && <button type=\"button\" onClick={() => onLinkProject(project, type.id)}>Relier un dossier <Icon name=\"plus\" size={13} /></button>}</div>}\n        </section>\n      })}\n    </div>\n    <div className=\"assets-cloud-destination\"><Icon name=\"lock.icloud\" size={22} /><div><span className=\"assets-eyebrow\">Destination du projet</span><code>{project.folder || 'Destination à définir'}</code></div>{onArchive && <ActionButton icon=\"arrow.up\" onClick={() => onArchive(project, [])} disabled={!connected || busy}>Sauvegarder le projet</ActionButton>}</div>\n    <p className=\"assets-footnote\">{connected && checkedAt ? <>Dernier relevé : <span className=\"assets-number\">{dateLabel(checkedAt)}</span>.</> : 'Connectez le Mac pour relever les dossiers actuels.'} Les emplacements restent visibles lorsque le Mac est déconnecté.</p>\n  </section>\n}\n\nfunction Activity({ events, project, onPreview }) {\n  if (!events.length) return <EmptyState icon=\"clock.arrow.2.circlepath\" title=\"Le suivi commence ici\">Les sauvegardes, chargements et notes de ce projet se réunissent dans cet historique.</EmptyState>\n  return <section className=\"assets-activity\" aria-label=\"Historique du projet\"><div className=\"assets-section-heading\"><div><h3>La mémoire du projet</h3><p>Les notes et les actions restent rattachées à leurs fichiers.</p></div></div><ol className=\"assets-timeline\">{events.map((event, index) => <li key={event.id || `${event.createdAt}:${index}`}><span className=\"assets-timeline-symbol\"><Icon name={event.type === 'feedback' || event.type === 'note' ? 'bubble.left' : event.type === 'restore' || event.type === 'load' ? 'arrow.down' : event.type === 'error' ? 'xmark' : 'arrow.up'} size={16} /></span><div className=\"assets-timeline-content\"><div><h4>{event.title || event.message || event.type || 'Action du projet'}</h4>{(event.createdAt || event.at || event.date) && <time className=\"assets-number\" dateTime={String(event.createdAt || event.at || event.date)}>{dateLabel(event.createdAt || event.at || event.date)}</time>}</div>{(event.detail || event.body) && <p>{event.detail || event.body}</p>}{event.file && onPreview && <button type=\"button\" className=\"assets-text-button\" onClick={() => onPreview(event.file, project)}>Lire le fichier <Icon name=\"arrow.up.right\" size={13} /></button>}</div></li>)}</ol></section>\n}\n\nexport default function ProjectWorkspace({\n  projects = [], activeProjectId, onSelectProject, workspaceProject, files: suppliedFiles, activity,\n  t, loading = false, error, offline = false, bridgeConnected = false, bridgeCheckedAt,\n  operation, onRetry, onLinkProject, onArchive, onLoad, onUnload, onDownload, onPreview,\n  onOpenPath, onOpenLegacy, renderThumbnail,\n}) {\n  const [internalProjectId, setInternalProjectId] = useState(null)\n  const [projectSearch, setProjectSearch] = useState('')\n  const [fileSearch, setFileSearch] = useState('')\n  const [sourceFilter, setSourceFilter] = useState('all')\n  const [statusFilter, setStatusFilter] = useState('all')\n  const [tab, setTab] = useState('files')\n  const [selected, setSelected] = useState(new Set())\n  const [focusId, setFocusId] = useState(null)\n  const [sort, setSort] = useState('name')\n  const [message, setMessage] = useState('')\n  const [actionBusy, setActionBusy] = useState(false)\n  const selectAllRef = useRef(null)\n  const currentId = activeProjectId ?? internalProjectId\n  const registryProject = projects.find((project) => project.id === currentId) || projects[0] || null\n  const project = registryProject ? workspaceProject?.id === registryProject.id ? { ...registryProject, ...workspaceProject } : registryProject : null\n  const projectId = project?.id\n  const projectFiles = suppliedFiles ?? project?.files ?? []\n  const files = useMemo(() => projectFiles.map(fileView), [projectFiles])\n  const sources = project?.sources || project?.origins || []\n  const events = activity ?? project?.events ?? project?.activity ?? []\n  const checkedAt = bridgeCheckedAt || project?.checkedAt\n  const busy = actionBusy || Boolean(operation && !['idle', 'complete', 'error'].includes(operation.state))\n  const visible = useMemo(() => {\n    const query = fileSearch.trim().toLocaleLowerCase('fr')\n    return files.filter((file) => (!query || file.searchable.includes(query)) && (sourceFilter === 'all' || sourceFilter === 'cloud' ? sourceFilter !== 'cloud' || file.contentPath || file.cloudPath : file.namespace === sourceFilter || sources.find((source) => source.id === file.sourceId)?.namespace === sourceFilter) && (statusFilter === 'all' || statusFilter === 'pending' ? statusFilter !== 'pending' || ['local-only', 'pending', 'modified', 'error'].includes(file.status) : file.status === statusFilter)).sort((left, right) => sort === 'size' ? (right.size || 0) - (left.size || 0) : sort === 'date' ? (right.mtimeMs || new Date(right.modifiedAt || 0).getTime()) - (left.mtimeMs || new Date(left.modifiedAt || 0).getTime()) : left.relativePath.localeCompare(right.relativePath, 'fr', { numeric: true }))\n  }, [files, fileSearch, sourceFilter, statusFilter, sort, sources])\n  const selectedFiles = files.filter((file) => selected.has(file.id))\n  const downloadableFiles = (selectedFiles.length ? selectedFiles : files).filter((file) => file.downloadable !== false && (file.contentPath || file.cloudPath))\n  const pendingCount = project?.sync?.pendingCount ?? fi