ace: file.namespace || file.source || file.sourceId?.split(':')[0] || '',\n    searchable: `${name} ${path} ${file.cloudPath || ''}`.toLocaleLowerCase('fr'),\n  }\n}\n\nfunction dateLabel(value) {\n  if (!value) return ''\n  const date = new Date(value)\n  return Number.isFinite(date.getTime()) ? dateFormat.format(date) : ''\n}\n\nfunction Status({ status = 'unknown', children }) {\n  const state = FILE_STATES[status] || { label: 'État inconnu', tone: 'quiet', icon: 'clock' }\n  return <span className={`assets-status assets-status-${state.tone}`}><span className=\"assets-status-dot\" aria-hidden=\"true\" />{children || state.label}</span>\n}\n\nfunction ActionButton({ icon, children, primary = false, ...props }) {\n  return <button type=\"button\" className={`assets-button${primary ? ' assets-button-primary' : ''}`} {...props}>{icon && <Icon name={icon} size={16} />}{children}</button>\n}\n\nfunction FileImage({ file, renderThumbnail, cover = false }) {\n  if (renderThumbnail && (file?.contentPath || file?.cloudPath)) return renderThumbnail(file, { size: cover ? 280 : 44, cover })\n  if (file?.thumbnailUrl || file?.coverUrl) return <img src={file.thumbnailUrl || file.coverUrl} alt=\"\" loading=\"lazy\" />\n  return <Icon name={KIND_ICONS[file?.kind] || 'doc'} size={cover ? 40 : 24} />\n}\n\nfunction ProjectRail({ projects, activeId, onSelect, onLinkProject, search, onSearch, renderThumbnail }) {\n  const visible = useMemo(() => {\n    const query = search.trim().toLocaleLowerCase('fr')\n    return projects.filter((project) => !query || `${project.name} ${project.category || ''} ${project.summary || ''}`.toLocaleLowerCase('fr').includes(query))\n  }, [projects, search])\n  return <aside className=\"assets-project-rail\" aria-label=\"Projets\">\n    <header className=\"assets-rail-heading\"><div><span className=\"assets-eyebrow\">Votre atelier</span><h1>ZenRay <em>Assets</em></h1></div><span className=\"assets-number assets-rail-count\">{numberFormat.format(projects.length)}</span></header>\n    <label className=\"assets-search assets-project-search\"><Icon name=\"magnifyingglass\" size={15} /><input aria-label=\"Rechercher un projet\" value={search} onChange={(event) => onSearch(event.target.value)} placeholder=\"Rechercher un projet\" />{search && <button type=\"button\" className=\"assets-icon-button\" aria-label=\"Effacer la recherche de projets\" onClick={() => onSearch('')}><Icon name=\"xmark\" size={13} /></button>}</label>\n    <div className=\"assets-rail-label\">Projets <span className=\"assets-number\">{numberFormat.format(visible.length)}</span></div>\n    <nav className=\"assets-project-list\" aria-label=\"Choisir un projet\">\n      {visible.map((project) => <button type=\"button\" className=\"assets-project-item\" data-active={project.id === activeId} aria-current={project.id === activeId ? 'page' : undefined} key={project.id} onClick={() => onSelect(project.id)}>\n        <span className=\"assets-project-miniature\">{project.coverFile ? <FileImage file={project.coverFile} renderThumbnail={renderThumbnail} /> : project.coverUrl ? <img src={project.coverUrl} alt=\"\" loading=\"lazy\" /> : <Icon name=\"archivebox\" size={20} />}</span>\n        <span className=\"assets-project-item-copy\"><span>{project.name}</span><small>{project.category || 'Projet'}</small></span><Icon name=\"chevron.right\" size={12} />\n      </button>)}\n      {!visible.length && <p className=\"assets-rail-empty\">{projects.length ? 'Aucun projet ne correspond.' : 'Votre premier projet apparaît ici.'}</p>}\n    </nav>\n    <div className=\"assets-rail-footer\"><ActionButton icon=\"plus\" onClick={onLinkProject} disabled={!onLinkProject}>Relier un projet</ActionButton><p>Un projet rassemble ses fichiers, ses notes et ses emplacements.</p></div>\n  </aside>\n}\n\nfunction EmptyState({ icon = 'doc.text', title, children, action }) {\n  return <div className=\"assets-empty\"><span className=\"assets-empty-icon\"><Icon name={icon} size={28} /></spa