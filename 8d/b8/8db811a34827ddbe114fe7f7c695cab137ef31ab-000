ntentPath === target) return true\n   599\t  return Object.values(node.children).some((c) => nodeHasPath(c, target))\n   600\t}\n   601\tfunction TreeItem({ node, depth, curPath, onOpen, t, prefix, onAddChild, onMovePage }) {\n   602\t  const kids = Object.keys(node.children).sort((a, b) => a.localeCompare(b))\n   603\t  const hasKids = kids.length > 0\n   604\t  const myPath = (prefix ? prefix + '/' : '') + node.name\n   605\t  const onPathInside = hasKids && nodeHasPath(node, curPath)\n   606\t  const [open, setOpen] = useState(onPathInside)\n   607\t  const [hover, setHover] = useState(false)\n   608\t  const [dragOver, setDragOver] = useState(false)\n   609\t  useEffect(() => { if (onPathInside) setOpen(true) }, [onPathInside])\n   610\t  const on = !!node.contentPath && curPath === node.contentPath\n   611\t  const handleName = () => { if (node.contentPath) onOpen(node.contentPath); else if (hasKids) setOpen((v) => !v) }\n   612\t  return (\n   613\t    <div>\n   614\t      <div className=\"zr-treeitem\" onMouseEnter={() => setHover(true)} onMouseLeave={() => setHover(false)}\n   615\t        onDragOver={(e) => { if (e.dataTransfer.types.includes('application/zenray-page')) { e.preventDefault(); setDragOver(true) } }}\n   616\t        onDragLeave={() => setDragOver(false)}\n   617\t        onDrop={(e) => { setDragOver(false); const d = e.dataTransfer.getData('application/zenray-page'); if (!d || !onMovePage) return; e.preventDefault(); e.stopPropagation(); try { const p = JSON.parse(d); setOpen(true); onMovePage(p.path, myPath) } catch {} }}\n   618\t        style={{ display: 'flex', alignItems: 'center', width: '100%', paddingLeft: 8 + depth * 12, paddingRight: 4, borderRadius: RADII.sm, background: dragOver ? PALETTE.primarySoft : (on ? PALETTE.primarySoft : 'transparent'), outline: dragOver ? `1px dashed ${PALETTE.primary}` : 'none' }}>\n   619\t        <span onClick={(e) => { e.stopPropagation(); if (hasKids) setOpen((v) => !v) }}\n   620\t          style={{ flex: '0 0 14px', width: 14, textAlign: 'center', cursor: hasKids ? 'pointer' : 'default', color: t.textSecondary, fontSize: 10, userSelect: 'none' }}>\n   621\t          {hasKids ? (open ? '▾' : '▸') : ''}\n   622\t        </span>\n   623\t        <button onClick={handleName} title={node.contentPath || node.name}\n   624\t          draggable={!!node.contentPath}\n   625\t          onDragStart={node.contentPath ? (e) => { e.dataTransfer.setData('application/zenray-page', JSON.stringify({ path: node.contentPath, name: node.name })); e.dataTransfer.effectAllowed = 'copy' } : undefined}\n   626\t          style={{ flex: 1, textAlign: 'left', padding: '5px 4px', background: 'transparent', border: 'none', cursor: 'pointer',\n   627\t            color: on ? PALETTE.primary : (node.contentPath ? t.textPrimary : t.textSecondary), fontFamily: FONTS.sans, fontSize: 13,\n   628\t            fontWeight: on ? 600 : (!node.contentPath && hasKids ? 600 : 400), whiteSpace: 'nowrap', overflow: 'hidden', textOverflow: 'ellipsis' }}>\n   629\t          {pgPretty(node.name)}{hasKids ? <span style={{ color: t.textSecondary, fontFamily: FONTS.mono, fontSize: 10, marginLeft: 6 }}>{kids.length}</span> : null}\n   630\t        </button>\n   631\t        <button onClick={(e) => { e.stopPropagation(); setOpen(true); onAddChild && onAddChild(myPath) }} title=\"Ajouter une sous-page\" className=\"zr-hover-action\"\n   632\t          style={{ flex: '0 0 auto', visibility: hover ? 'visible' : 'hidden', background: 'transparent', border: 'none', cursor: 'pointer', color: t.textSecondary, fontSize: 15, lineHeight: 1, padding: '0 4px' }}>+</button>\n   633\t      </div>\n   634\t      {open && hasKids && kids.map((k) => (\n   635\t        <TreeItem key={k} node={node.children[k]} depth={depth + 1} curPath={curPath} onOpen={onOpen} t={t} prefix={myPath} onAddChild={onAddChild} onMovePage={onMovePage} />\n   636\t      ))}\n   637\t    </div>\n   638\t  )\n   639\t}\n   640\tfunction TreeNode({ node, depth, curPath, onOpen, t, prefix, onAddChild, onMovePage }) {\n   641\t  return (\n   642\t    <>\n   643\t      {Object.keys(node.children).sort((a, b) => a.localeCompare(b)).map((k) => (\n   644\t        <TreeItem key={k} node={node.children[k]} depth={depth} curPath={curPath} onOpen={onOpen} t={t} prefix={prefix} onAddChild={onAddChild} onMovePage={onMovePage} />\n   645\t      ))}\n   646\t    </>\n   647\t  )\n   648\t}\n   649\t// Grille d'icônes VIRTUALISÉE (rendu fenêtré). Au-delà de ~200 tuiles, peindre tout le DOM rame :\n   650\t// ici on ne monte QUE les rangées visibles dans le conteneur scrollable + une marge (overscan).\n   651\t// Hauteur totale simulée par un conteneur vide, le bloc rendu est décalé en translateY.\n   652\tfunction VirtualIconGrid({ entries, zoom, scrollRef, renderTile }) {\n   653\t  const GAP = 4, ROW_H = 124, OVERSCAN = 3\n   654\t  const [width, setWidth] = useState(0)\n   655\t  const [scrollTop, setScrollTop] = useState(0)\n   656\t  const [viewH, setViewH] = useState(800)\n   657\t  useEffect(() => {\n   658\t    const el = scrollRef.current\n   659\t    if (!el) return\n   660\t    const onScroll = () => setScrollTop(el.scrollTop)\n   661\t    const measure = () => { setWidth(el.clientWidth - 32); setViewH(el.clientHeight) } // -32 = padding 16 gauche+droite\n   662\t    measure()\n   663\t    el.addEventListener('scroll', onScroll, { passive: true })\n   664\t    const ro = typeof ResizeObserver !== 'undefined' ? new ResizeObserver(measure) : null\n   665\t    if (ro) ro.observe(el)\n   666\t    window.addEventListener('resize', measure)\n   667\t    return () => { el.removeEventListener('scroll', onScroll); if (ro) ro.disconnect(); window.removeEventListener('resize', measure) }\n   668\t  }, [scrollRef])\n   669\t  const cols = Math.max(1, Math.floor((width + GAP) / (zoom + GAP))) || 1\n   670\t  const totalRows = Math.ceil(entries.length / cols)\n   671\t  const totalH = totalRows * ROW_H\n   672\t  const firstRow = Math.max(0, Math.floor(scrollTop / ROW_H) - OVERSCAN)\n   673\t  const lastRow = Math.min(totalRows, Math.ceil((scrollTop + viewH) / ROW_H) + OVERSCAN)\n   674\t  const slice = entries.slice(firstRow * cols, lastRow * cols)\n   675\t  return (\n   676\t    <div style={{ position: 'relative', height: totalH }}>\n   677\t      <div style={{ position: 'absolute', top: firstRow * ROW_H, left: 0, right: 0, display: 'grid', gridTemplateColumns: `repeat(${cols}, minmax(0, 1fr))`, gap: GAP }}>\n   678\t        {slice.map((e) => renderTile(e))}\n   679\t      </div>\n   680\t    </div>\n   681\t  )\n   682\t}\n   683\tfunction Pages({ t }) {\n   684\t  const [paths, setPaths] = useState(null) // string[] full paths\n   685\t  const [cur, setCur] = useState(() => { try { const p = localStorage.getItem('zr:create:cur'); return p ? { path: p } : null } catch { return null } }) // { path } — restauré au reload\n   686\t  useEffect(() => { try { if (cur && cur.path) localStorage.setItem('zr:create:cur', cur.path); else localStorage.removeItem('zr:create:cur') } catch {} }, [cur])\n   687\t  const [status, setStatus] = useState('')\n   688\t  const [q, setQ] = useState('')\n   689\t  // vue Finder PERSISTÉE (list | icons | gallery) : le choix reste en mémoire entre dossiers/pages.\n   690\t  const [view, setViewRaw] = useState(() => { try { return localStorage.getItem('zr:create:view') || 'icons' } catch { return 'icons' } })\n   691\t  const setView = (v) => { setViewRaw(v); try { localStorage.setItem('zr:create:view', v) } catch {} }\n   692\t  // Dossier courant du Finder, PERSISTÉ (localStorage) comme `view`/`cur` : après un reload, on reste\n   693\t  // dans le dossier où on était, donc un drop/Ctrl-V juste après un reload atterrit au bon endroit (pas à la racine).\n   694\t  const [folder, setFolderRaw] = useState(() => { try { return localStorage.getItem('zr:create:folder') || 'pages' } catch { return 'pages' } })\n   695\t  const setFolder = (f) => { setFolderRaw(f); try {