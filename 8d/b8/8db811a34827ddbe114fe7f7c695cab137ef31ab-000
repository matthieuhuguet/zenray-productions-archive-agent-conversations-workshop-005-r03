const [renameVal, setRenameVal] = useState('')\n   715\t  const [selected, setSelected] = useState(() => new Set()) // C17 sélection multiple\n   716\t  const [quick, setQuick] = useState(null) // C24 Quick Look { entry }\n   717\t  const [dropDir, setDropDir] = useState(null) // C23 cible de drop survolée\n   718\t  const lastSel = useRef(null)\n   719\t  const gridScrollRef = useRef(null) // conteneur scrollable de la grille (virtualisation >200 tuiles)\n   720\t  const shownRef = useRef([])\n   721\t  const histRef = useRef([]) // historique des pages ouvertes (bouton retour)\n   722\t  // C217 — Finder responsive : sous 860px on empile (colonnes favoris/inspecteur masquées inline, ouvrables en drawers).\n   723\t  // P9 — seuil aligné sur celui de la sidebar (860) pour supprimer la zone bâtarde 760-860 où la sidebar flottait\n   724\t  // déjà mais le Finder gardait ses colonnes inline dans un espace serré.\n   725\t  const [narrowFinder, setNarrowFinder] = useState(typeof window !== 'undefined' ? window.innerWidth < 860 : false)\n   726\t  const [drawer, setDrawer] = useState(null) // 'fav' | 'inspect' | null\n   727\t  useEffect(() => {\n   728\t    const onR = () => { const n = window.innerWidth < 860; setNarrowFinder(n); if (!n) setDrawer(null) }\n   729\t    window.addEventListener('resize', onR); return () => window.removeEventListener('resize', onR)\n   730\t  }, [])\n   731\t\n   732\t  const [tags, setTags] = useState({})       // { 'pages/x.md': 'red' } — tags couleur façon Finder\n   733\t  const [tagFilter, setTagFilter] = useState(null)\n   734\t  const [eagleView, setEagleView] = useState(null) // C211h vue système Eagle: 'untagged'|'recent-added'|'random'\n   735\t  const tagSha = useRef(null)\n   736\t  const TAGS_PATH = 'pages/.zr-tags.json'\n   737\t\n   738\t  // C27 — favoris : épingler n'importe quelle page OU dossier (y compris sous-pages) dans la barre latérale. Stocké localStorage.\n   739\t  const [favorites, setFavorites] = useState(() 